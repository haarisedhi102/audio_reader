{
  "name": "glasses-reader",
  "private": true,
  "version": "0.2.20",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:prod": "test -n \"$VITE_LIB_BASE\" || { echo 'set VITE_LIB_BASE first'; exit 1; }; tsc --noEmit && vite build",
    "pack": "npx @evenrealities/evenhub-cli pack app.json dist -o glasses-reader.ehpk",
    "preview": "vite preview --host"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.16",
    "@evenrealities/pretext": "^0.1.4"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
